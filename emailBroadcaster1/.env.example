APP_BASE_URL=http://101.50.2.56/emailBroadcaster
APP_TIMEZONE=Asia/Jakarta
ORGANIZATION_NAME=Raudlatul Jannah Sidoarjo
API_TOKEN=

DB_DRIVER=sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=email_broadcaster
# DB_USER=root
# DB_PASS=

EMAIL_BATCH_SIZE=20
# Saat tagihan sibuk + ada bayar: cadangkan N akun SMTP khusus pembayaran (contoh 3 akun → 2 tagihan + 1 bayar)
PAYMENT_RESERVE_ACCOUNTS=1
# Fallback jika hanya 1 akun aktif: sisakan N slot pesan untuk bayar
PAYMENT_RESERVE_SLOTS=1
# Pending ≤20 → 1 akun; ≤40 → 2 akun; >40 → 3 akun
SMTP_SINGLE_ACCOUNT_MAX=20
SMTP_TWO_ACCOUNT_MAX=40
SMTP_QUOTA_PER_ACCOUNT=20
SMTP_QUOTA_WINDOW_SECONDS=600
EMAIL_SEND_DELAY_US=200000

MAIL_FROM_NAME=Noreply Raudlatul Jannah
MAIL_REPLY_TO=
# Logo di header email (CID). Ganti file/URL ke logo Bank Muamalat untuk notifikasi pembayaran.
MAIL_LOGO_URL=logo.png
YAYASAN_NAME=Yayasan Masjid Raudlatul Jannah
DEFAULT_PAYMENT_LINK=https://tagihan-raudlatuljannah-sidoarjo.smartpayment.co.id/
DEFAULT_PORTAL_PASSWORD=123

# --- Multi SMTP (isi App Password Gmail, jangan commit .env) ---
